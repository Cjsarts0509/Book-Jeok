# docker-compose 용 루트 환경변수. `cp .env.example .env` 후 값 채우기.

# 오라클 클라우드 독립 블록 볼륨 마운트 지점 (DB + 파일 저장)
DATA_ROOT=/mnt/bookjeok-data

# PostgreSQL
DB_USER=bookjeok
DB_PASSWORD=반드시_강력한_비밀번호로_변경
DB_NAME=bookjeok

# 프런트엔드를 API 서버가 함께 서빙 (1) / CF Pages 별도 배포 (0)
SERVE_FRONTEND=1

# 보안 키 — 반드시 아래 명령으로 생성해서 채우세요:
#   openssl rand -hex 32
JWT_SECRET=
MASTER_KEY=

# CORS 허용 도메인 (프런트 배포 주소). SERVE_FRONTEND=1 이면 서버 도메인.
CORS_ORIGINS=https://your-domain.example,http://localhost:4000

# 최초 관리자
SUPER_ADMINS=admin
ADMIN_PASSWORD=

# ── 선택 항목 (미설정 시 기본값) ──────────────
# 업로드 1건 최대 크기(bytes, 기본 2GB) · 계정 기본 할당량(bytes, 0=무제한)
MAX_UPLOAD_BYTES=
DEFAULT_QUOTA=

# ISBN 바코드로 제목·저자를 자동으로 채운다.
#   naver        국내서. BOOK_API_KEY 를 "클라이언트ID:시크릿" 형식으로.
#   openlibrary  키 불필요(기본값). 해외서 위주라 국내서 적중률은 낮다.
BOOK_API_PROVIDER=
BOOK_API_KEY=

# IP당 15분 요청 한도(기본 300). 부하 시험 때만 임시로 올린다.
API_RATE_LIMIT_MAX=

# 메일 회신 주소(선택)
MAIL_REPLY_TO=

# 목록 캐시 끄기(문제 발생 시 0). 미설정이면 켜짐.
LIST_CACHE=
