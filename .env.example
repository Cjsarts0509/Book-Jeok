# docker-compose 용 루트 환경변수. `cp .env.example .env` 후 값 채우기.

# 오라클 클라우드 독립 블록 볼륨 마운트 지점 (DB + 파일 저장)
DATA_ROOT=/mnt/bookjeok-data

# PostgreSQL
DB_USER=bookjeok
DB_PASSWORD=반드시_강력한_비밀번호로_변경
DB_NAME=bookjeok

# 프런트엔드를 API 서버가 함께 서빙 (1) / CF Pages 별도 배포 (0)
SERVE_FRONTEND=1

# 보안 키 — 반드시 아래 명령으로 생성해서 채우세요:
#   openssl rand -hex 32
JWT_SECRET=
MASTER_KEY=

# CORS 허용 도메인 (프런트 배포 주소). SERVE_FRONTEND=1 이면 서버 도메인.
CORS_ORIGINS=https://your-domain.example,http://localhost:4000

# 최초 관리자
SUPER_ADMINS=admin
ADMIN_PASSWORD=
